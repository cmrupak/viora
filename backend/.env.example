APP_ENV=local
APP_DEBUG=true
APP_URL=http://viora.test/backend/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=viora
DB_USER=root
DB_PASS=

JWT_SECRET=change-me-local-only-viora-jwt-secret
JWT_ISSUER=viora-api
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

CORS_ORIGINS=*

# Optional for local — if empty, OTP codes are written to backend/storage/logs/otp.log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
