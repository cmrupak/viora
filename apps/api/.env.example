# ---------------------------------------------------------------------------
# Supabase Postgres (active)
# Project Settings → Database → Connection string → URI
# Use "Session mode" pooler OR Direct connection. Prefer Session pooler for Node.
# Example (replace password + project ref):
# DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

