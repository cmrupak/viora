# --- Backend mode ---
# Default / production: supabase
# Local Laragon PHP:
# EXPO_PUBLIC_API_BACKEND=php
# EXPO_PUBLIC_API_BASE_URL=http://viora.test/backend/public
# (Use your machine LAN IP instead of viora.test when testing on a physical device.)

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Netlify origin for account export/delete when on Supabase mode
# EXPO_PUBLIC_WEB_API_URL=https://vioradev.netlify.app
