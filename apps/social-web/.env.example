VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional — used by /app download page
# VITE_ANDROID_APK_URL=https://your-cdn.example/viora-android.apk
# VITE_IOS_APP_URL=https://apps.apple.com/...

# Password OTP (local Vite middleware). Prefer repo-root `.env.smtp` (gitignored)
# or put these in apps/api/.env — never use VITE_ prefix for secrets.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Viora <you@example.com>
